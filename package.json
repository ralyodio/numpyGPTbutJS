{
  "name": "numpygpt-js",
  "version": "1.0.0",
  "description": "GPT from scratch. Pure JavaScript/Node.js implementation with explicit gradients.",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "type": "module",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "datagen": "node datagen.js",
    "train": "node train.js",
    "sample": "node sample.js",
    "plot": "node plot.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:nn": "jest tests/test_nn",
    "test:optim": "jest tests/test_optim",
    "test:tokenizer": "jest tests/test_tokenizer",
    "lint": "eslint src/ *.js",
    "lint:fix": "eslint src/ *.js --fix",
    "format": "prettier --write src/ *.js",
    "format:check": "prettier --check src/ *.js",
    "build:browser": "webpack --config webpack.config.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir types",
    "dev:browser": "webpack serve --config webpack.config.js --mode development",
    "validate": "node validate_parity.js",
    "benchmark": "node benchmark.js"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".js"],
    "globals": {
      "NODE_OPTIONS": "--experimental-vm-modules"
    },
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codiceSpaghetti/numpyGPT.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/codiceSpaghetti/numpyGPT/issues"
  },
  "homepage": "https://github.com/codiceSpaghetti/numpyGPT#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "fs-extra": "^11.3.0",
    "ml-matrix": "^6.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "jest": "^30.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "babel-loader": "^9.1.0"
  }
}
